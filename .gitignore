# Competition data — 16 GB, published by the organizers, not ours to redistribute.
# Fetch it from Hugging Face; see the README.
NeurIPS 2026 RealPDE Competition/*
!NeurIPS 2026 RealPDE Competition/*.md

# Organizer-supplied starting kits: available from Codabench to registered teams.
realpde_t1_starting_kit_v9/
realpde_t2_starting_kit_v6/

# Derived from the release by scripts/prepare_data.py (~3.3 GB)
data/processed/

# Environment (~4.7 GB)
.venv/
__pycache__/
*.pyc

# Training artefacts. Checkpoints are small but one appears per run; the
# submitted one is kept deliberately, under submissions/.
checkpoints/*.pt
checkpoints/*_history.json

# ...except the ones a submission actually rests on. These are 6.8 MB each and
# exist nowhere else: the archives under submissions/ are ignored too, so
# without these the best result we have could not be rebuilt or modified.
# sps_sigma.npz belongs here for the same reason — the interval bounds it feeds
# are most of the score, and it cannot be recovered without re-running the fit.
!checkpoints/adv_finetuned_best.pt
!checkpoints/adv_finetuned_history.json
!checkpoints/adv_denoise_best.pt
!checkpoints/adv_denoise_history.json
!checkpoints/sps_sigma.npz
!checkpoints/sps_sigma_denoise.npz
# Track 1 best since 2026-09-21 (t1_solverloop, 78.858), and the model the
# standard recipe is measured against on the extrapolation split.
!checkpoints/sl_default_best.pt
!checkpoints/sl_default_history.json
!checkpoints/sps_sigma_sl_default.npz
!checkpoints/xf_scaleinv_best.pt
!checkpoints/xf_scaleinv_history.json
figures/*.gif

# Built submission archives and their unpacked staging directories
submissions/*.zip
submissions/*/
# The templates are source, not build output: everything else under submissions/
# is a staging directory the build script recreates from them.
!submissions/template/
!submissions/t2_template/
submissions/t2_template/model.pth
submissions/t2_template/sps_sigma.npz
submissions/t2_template/sps_empirical.npz
submissions/t2_template/model_def.py
submissions/t2_template/advection.py

# Organizer baseline checkpoints, ~460 MB, fetched from the competition data repo
baselines/

# Personal working notes, not repository content
WALKTHROUGH.md
NeurIPS 2026 RealPDE Competition/izah.md
